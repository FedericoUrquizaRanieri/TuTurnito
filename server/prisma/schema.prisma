datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  JUGADOR
  DUEÑO
  PROFESOR
}

enum TurnState {
  AVAILABLE
  OCCUPIED
  BLOCKED
  TOURNAMENT
}

enum ReservationType {
  PLAYER
  CLASS
}

enum PaymentStatus {
  PAID
  PENDING
}

enum PayableType {
  RESERVATION
  STUDENT_CLASS
}

enum CancelledBy {
  PLAYER
  OWNER
  PROFESSOR
}

enum ProfessorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  emailReminders Boolean @default(true) // recordatorio por email antes de cada turno
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  ownedComplexes    Complex[]          @relation("OwnerComplexes")
  reservations      Reservation[]      @relation("UserReservations")
  professorClasses  Reservation[]      @relation("ProfessorClasses")
  recordedPayments  Payment[]          @relation("RecordedPayments")
  professorRequests ProfessorRequest[] @relation("ProfessorRequests")
  complexLinks      ProfessorComplex[] @relation("ProfessorComplexLinks")
  students          Student[]          @relation("ProfessorStudents")
  classSchedules    ClassSchedule[]    @relation("ProfessorClassSchedules")
  organizedMatches  OpenMatch[]        @relation("OpenMatchOrganizer")
  joinedMatches     MatchPlayer[]
}

model Complex {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique // URL pública: tuturnito.com/<slug>
  location     String    // Ciudad / Zona (ej: "Bahía Blanca", "Palermo, CABA")
  address      String    // Dirección exacta (ej: "Av. Alem 1234")
  description  String?
  phone        String?
  openingHours String?   // ej: "Lun a Dom 08:00 - 23:30"
  timezone     String    @default("America/Argentina/Buenos_Aires")
  // Política de cancelación: el jugador puede cancelar desde la app hasta
  // estas horas antes del turno (0 = hasta que empieza). El dueño, siempre.
  cancellationHours Int  @default(0)
  imageUrl     String?
  ownerId      String
  owner        User      @relation("OwnerComplexes", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  courts            Court[]
  reservations      Reservation[]
  professorRequests ProfessorRequest[]
  professorLinks    ProfessorComplex[]
  fixedBookings     FixedBooking[]
  classSchedules    ClassSchedule[]
  closures          Closure[]
  priceRules        PriceRule[]
  cancellations     ReservationCancellation[]
}

model Court {
  id         String   @id @default(uuid())
  complexId  String
  complex    Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  name       String   // ej: "Cancha 1 Cristal", "Cancha 2 Panorámica"
  order      Int      @default(0)
  active     Boolean  @default(true)
  // Rango horario de la cancha: la grilla de turnos se genera desde openTime
  // hasta closeTime en bloques de slotMinutes, todos los días igual.
  openTime    String   @default("08:00") // "HH:MM"
  closeTime   String   @default("23:00") // "HH:MM" ("24:00" = medianoche)
  slotMinutes Int      @default(90)
  basePrice   Float    @default(12000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  turns          Turn[]
  fixedBookings  FixedBooking[]
  classSchedules ClassSchedule[]
  priceRules     PriceRule[]
}

model Turn {
  id           String    @id @default(uuid())
  courtId      String
  court        Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  date         String    // "YYYY-MM-DD"
  startTime    String    // "08:00"
  endTime      String    // "09:30"
  price        Float
  state        TurnState @default(AVAILABLE)
  // true cuando el dueño cambió estado/precio a mano (o canceló una
  // ocurrencia de un turno fijo): la sincronización automática no lo pisa.
  manualOverride Boolean @default(false)
  label        String?   // Nombre del torneo / nota del dueño
  // Cierre (feriado, mantenimiento) que bloqueó este turno. Sin relación a
  // propósito: al borrar el cierre la re-sincronización ve que ya no existe
  // y libera el turno.
  closureId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reservation Reservation?

  @@unique([courtId, date, startTime])
}

model Reservation {
  id          String          @id @default(uuid())
  turnId      String          @unique
  turn        Turn            @relation(fields: [turnId], references: [id], onDelete: Cascade)
  complexId   String
  complex     Complex         @relation(fields: [complexId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?           @relation("UserReservations", fields: [userId], references: [id], onDelete: SetNull)
  guestName   String
  guestPhone  String
  guestEmail  String?
  type        ReservationType @default(PLAYER)
  professorId String?
  professor   User?           @relation("ProfessorClasses", fields: [professorId], references: [id], onDelete: SetNull)
  notes       String?
  fixedBookingId String?
  fixedBooking   FixedBooking? @relation(fields: [fixedBookingId], references: [id], onDelete: SetNull)
  classScheduleId String?
  classSchedule   ClassSchedule? @relation(fields: [classScheduleId], references: [id], onDelete: SetNull)
  // Cuándo se mandó el recordatorio por email (null = todavía no). Se
  // reclama antes de mandar, así dos servidores no lo mandan dos veces.
  reminderSentAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  openMatch   OpenMatch?
}

// Turno fijo: mismo día y horario todas las semanas. Cada ocurrencia se
// materializa como una Reservation real (con su Payment) al generar turnos.
model FixedBooking {
  id         String   @id @default(uuid())
  complexId  String
  complex    Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  courtId    String
  court      Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Domingo ... 6 = Sábado
  startTime  String   // "HH:MM"
  guestName  String
  guestPhone String
  notes      String?
  startDate  String   // "YYYY-MM-DD"
  endDate    String?  // "YYYY-MM-DD"
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reservations Reservation[]
}

// Cierre del complejo (feriado, mantenimiento, evento): todas las canchas
// quedan bloqueadas desde startDate hasta endDate (inclusive). Los turnos de
// esos días se crean/pasan a BLOCKED con su closureId, así que ni los turnos
// fijos ni las clases se materializan ahí.
model Closure {
  id        String   @id @default(uuid())
  complexId String
  complex   Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  startDate String   // "YYYY-MM-DD"
  endDate   String   // "YYYY-MM-DD" (inclusive)
  reason    String
  createdAt DateTime @default(now())

  @@index([complexId, startDate])
}

// Precio por franja: los turnos que empiezan en [startTime, endTime) de esos
// días cuestan `price` en vez del basePrice de la cancha. Una regla de una
// cancha puntual gana sobre una de todas las canchas (courtId null).
model PriceRule {
  id         String   @id @default(uuid())
  complexId  String
  complex    Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  courtId    String?
  court      Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)
  daysOfWeek Int[]    // 0 = Domingo ... 6 = Sábado
  startTime  String   // "HH:MM"
  endTime    String   // "HH:MM" (exclusivo; "24:00" = hasta el cierre)
  price      Float
  label      String?  // ej: "Hora pico", "Promo mañana"
  createdAt  DateTime @default(now())

  @@index([complexId])
}

// Registro de cada reserva cancelada (la reserva y su pago se borran al
// cancelar). Alimenta las analíticas: cuántas, con cuánta anticipación y
// quién canceló.
model ReservationCancellation {
  id             String          @id @default(uuid())
  complexId      String
  complex        Complex         @relation(fields: [complexId], references: [id], onDelete: Cascade)
  courtId        String
  date           String          // "YYYY-MM-DD" del turno
  startTime      String          // "HH:MM"
  price          Float
  type           ReservationType
  wasFixed       Boolean         @default(false)
  guestName      String
  guestPhone     String
  cancelledBy    CancelledBy
  minutesBefore  Int             // minutos entre la cancelación y el inicio del turno
  cancelledAt    DateTime        @default(now())

  @@index([complexId, date])
}

// Partido abierto: quien reservó publica que le faltan jugadores y otros
// usuarios se suman directo hasta completar los lugares. Se borra con la
// reserva.
model OpenMatch {
  id            String        @id @default(uuid())
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  organizerId   String
  organizer     User          @relation("OpenMatchOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  spots         Int           // jugadores que faltan (1–3)
  joinedCount   Int           @default(0) // se incrementa con un update condicionado: nunca supera `spots`
  category      String?       // "Principiante", "Intermedio", "Avanzado", "1ra".."8va"
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  players MatchPlayer[]
}

model MatchPlayer {
  id          String    @id @default(uuid())
  openMatchId String
  openMatch   OpenMatch @relation(fields: [openMatchId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([openMatchId, userId])
}

model Payment {
  id           String        @id @default(uuid())
  payableType  PayableType
  payableId    String        // ID de Reservation o ID de Student
  amount       Float
  status       PaymentStatus @default(PENDING)
  date         String        // "YYYY-MM-DD"
  recordedById String
  recordedBy   User          @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: Cascade)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([payableType, payableId])
}

model ProfessorRequest {
  id          String                 @id @default(uuid())
  professorId String
  professor   User                   @relation("ProfessorRequests", fields: [professorId], references: [id], onDelete: Cascade)
  complexId   String
  complex     Complex                @relation(fields: [complexId], references: [id], onDelete: Cascade)
  status      ProfessorRequestStatus @default(PENDING)
  requestedAt DateTime               @default(now())
  resolvedAt  DateTime?
}

model ProfessorComplex {
  id          String   @id @default(uuid())
  professorId String
  professor   User     @relation("ProfessorComplexLinks", fields: [professorId], references: [id], onDelete: Cascade)
  complexId   String
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  active      Boolean  @default(true)
  joinedAt    DateTime @default(now())

  @@unique([professorId, complexId])
}

// Horario de clases de un profesor: una cancha, varios días de la semana y
// una franja horaria (ej. Cancha 2, Lun/Mié/Vie 18:00-21:00). Cada turno de
// la franja es una "clase" y se materializa como Reservation de tipo CLASS.
// Es independiente de FixedBooking: el dueño no lo ve en "Turnos fijos".
model ClassSchedule {
  id          String   @id @default(uuid())
  professorId String
  professor   User     @relation("ProfessorClassSchedules", fields: [professorId], references: [id], onDelete: Cascade)
  complexId   String
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  courtId     String
  court       Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  daysOfWeek  Int[]    // 0 = Domingo ... 6 = Sábado
  startTime   String   // "HH:MM" (inicio del primer turno)
  endTime     String   // "HH:MM" (fin del último turno)
  startDate   String   // "YYYY-MM-DD"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
  enrollments  ClassEnrollment[]
}

// Alumno inscripto en una clase semanal (horario + día + hora de inicio),
// con el valor que paga por cada clase. Máximo 4 por clase. Al quitarlo se
// cierra con endDate para que su deuda histórica se conserve.
model ClassEnrollment {
  id              String        @id @default(uuid())
  classScheduleId String
  classSchedule   ClassSchedule @relation(fields: [classScheduleId], references: [id], onDelete: Cascade)
  dayOfWeek       Int
  startTime       String        // "HH:MM"
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  price           Float         // valor actual (el historial está en ClassEnrollmentPrice)
  startDate       String        // "YYYY-MM-DD": clases desde esta fecha generan deuda
  endDate         String?       // "YYYY-MM-DD": exclusivo; null = sigue inscripto
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  absences ClassAbsence[]
  prices   ClassEnrollmentPrice[]

  @@index([classScheduleId, dayOfWeek, startTime])
}

// Historial del valor por clase de una inscripción: cada clase se cobra con
// el precio vigente en su fecha, así un aumento no cambia las clases pasadas.
model ClassEnrollmentPrice {
  id           String          @id @default(uuid())
  enrollmentId String
  enrollment   ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  price        Float
  fromDate     String          // "YYYY-MM-DD": rige para las clases desde esta fecha
  createdAt    DateTime        @default(now())

  @@unique([enrollmentId, fromDate])
}

// El alumno faltó (o avisó que va a faltar) a la clase de esa fecha: esa
// clase no se le cobra.
model ClassAbsence {
  id           String          @id @default(uuid())
  enrollmentId String
  enrollment   ClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         String          // "YYYY-MM-DD"
  createdAt    DateTime        @default(now())

  @@unique([enrollmentId, date])
}

model Student {
  id          String   @id @default(uuid())
  professorId String
  professor   User     @relation("ProfessorStudents", fields: [professorId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments ClassEnrollment[]
}
