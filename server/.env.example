PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/tuturnito_dev"
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_URL="http://localhost:5173"

# Email (recordatorios y avisos de partidos abiertos). Cualquier proveedor SMTP:
# Resend, Brevo, Gmail... Sin SMTP_HOST los emails se imprimen en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TuTurnito <no-reply@tuturnito.com>"

# Cloudflare Turnstile (captcha invisible en registro y login). Crealo gratis en
# dash.cloudflare.com > Turnstile; la site key va en web/.env (VITE_TURNSTILE_SITE_KEY).
# Vacío = sin captcha (desarrollo).
TURNSTILE_SECRET=
