# Copiá este archivo a web/.env para configurar el frontend.

# Email al que escriben los complejos que se quieren sumar (las cuentas de
# dueño se crean a mano con `npm run create-owner` en server/).
# Vacío = no se muestra el link.
VITE_CONTACT_EMAIL=

# Cloudflare Turnstile (captcha invisible en registro y login). La secret key
# va en server/.env (TURNSTILE_SECRET). Vacío = sin captcha (desarrollo).
VITE_TURNSTILE_SITE_KEY=
